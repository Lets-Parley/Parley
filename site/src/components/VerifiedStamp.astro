---
// Says what version a page was transcribed against and which file it came
// from, so a reader can check it. The version is deliberately not a prop —
// as one it was hardcoded on 22 pages that could drift apart independently.
import { existsSync } from "node:fs";
import { dirname, resolve, sep } from "node:path";
import { VERIFIED_VERSION } from "../verified.ts";

const { source } = Astro.props;
const repo = "https://github.com/lets-parley/parley/blob/main/";
// Anchor on a file only the repo root has: `import.meta.url` points into a
// bundled chunk under dist/ by the time this runs, and cwd depends on where
// the build was invoked from.
let root = process.cwd();
while (!existsSync(resolve(root, "go.mod")) && dirname(root) !== root) {
  root = dirname(root);
}
// Blank entries throw rather than being filtered out — dropping one silently
// would cite fewer files than the author wrote.
const files = (Array.isArray(source) ? source : source === undefined ? [] : [source])
  .map((f) => (typeof f === "string" ? f.trim() : f));
const blank = files.filter((f) => typeof f !== "string" || f === "");
if (blank.length) {
  throw new Error(
    `VerifiedStamp: ${blank.length} \`source\` entr${blank.length > 1 ? "ies are" : "y is"} ` +
      `blank or not a string — name a file or drop the entry.`
  );
}

if (files.length === 0) {
  throw new Error(
    "VerifiedStamp: `source` is required — name at least one file a reader can open."
  );
}

// An absolute or `../` path can exist on the build machine while pointing at
// nothing a reader can open, so confine it to the repo before checking.
const outside = files.filter((f) => !resolve(root, f).startsWith(resolve(root) + sep));
if (outside.length) {
  throw new Error(
    `VerifiedStamp: source must be repo-relative: ${outside.join(", ")}`
  );
}
const missing = files.filter((f) => !existsSync(resolve(root, f)));
if (missing.length) {
  throw new Error(
    `VerifiedStamp: source not in the repo: ${missing.join(", ")} — the stamp ` +
      `tells a reader they can open it.`
  );
}
---
<p class="stamp">
  Verified against <strong>{VERIFIED_VERSION}</strong>
  {" · "}{files.map((f, i) => (<>
    {i > 0 && <span>, </span>}<a href={`${repo}${f}`}><code>{f}</code></a>
  </>))}
</p>

<style>
  .stamp {
    font-size: 0.8125rem; color: var(--parley-muted);
    border-left: 2px solid var(--sl-color-accent);
    padding: 0.15rem 0 0.15rem 0.7rem; margin: 0 0 1.5rem;
  }
  .stamp code { font-size: 0.8125rem; background: none; padding: 0; }
</style>
