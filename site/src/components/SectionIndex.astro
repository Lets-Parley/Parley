---
// Card grid for a section landing page. Starlight generates no index page for
// a sidebar group, so without this every group label is a dead click.
// items: [{ title, href, blurb }]
const { items = [] } = Astro.props;
---
<div class="grid">
  {items.map((i) => (
    <a class="card" href={i.href}>
      <span class="title">{i.title}</span>
      <span class="blurb">{i.blurb}</span>
    </a>
  ))}
</div>

<style>
  .grid {
    display: grid; gap: 0.85rem; margin: 1.5rem 0;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .card {
    display: flex; flex-direction: column; gap: 0.3rem;
    border: 1px solid var(--parley-line);
    border-radius: var(--parley-radius-card);
    padding: 0.9rem 1.05rem; background: var(--parley-surface-hi);
    box-shadow: var(--parley-shadow-rest);
    text-decoration: none; color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
    box-shadow: var(--parley-shadow-lift);
  }
  .title { font-weight: 600; color: var(--sl-color-text-accent); }
  .blurb { font-size: 0.9375rem; color: var(--parley-muted); }
  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
    .card:hover { transform: none; }
  }
</style>
