{
  "manifest": 1,
  "kind": "plugin",
  "name": "settings-demo",
  "version": "0.1.0",
  "capabilities": [],
  "kinds": [{ "kind": "settings-demo", "display": "Settings demo", "actions": [] }],
  "settings": {
    "type": "object",
    "properties": {
      "greeting": { "type": "string", "title": "Greeting", "default": "Hello", "maxLength": 80 },
      "loud": { "type": "boolean", "title": "Shout it", "default": false },
      "mood": { "type": "string", "title": "Team mood", "enum": ["calm", "busy", "celebrating"], "default": "calm" },
      "apiToken": { "type": "string", "title": "API token", "description": "Never shown to anyone once saved.", "format": "secret" }
    },
    "required": ["greeting", "mood"],
    "additionalProperties": false
  }
}
