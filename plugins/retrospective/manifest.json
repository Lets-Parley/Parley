{
  "manifest": 1,
  "kind": "plugin",
  "name": "retrospective",
  "version": "0.2.0",
  "quotaBytes": 1048576,
  "capabilities": [
    { "capability": "kv", "scope": "board" },
    { "capability": "session:read" },
    { "capability": "session:act" }
  ],
  "kinds": [
    {
      "kind": "retrospective",
