# Required. Postgres password used by both containers.
POSTGRES_PASSWORD=

# The address users reach the app at. Drives the WebSocket origin check and
# whether the session cookie is marked Secure. Change this if teammates connect
# over the network, e.g. http://192.168.1.10:8080 or https://parley.example.com
BASE_URL=http://localhost:8080

# debug | info | warn | error
LOG_LEVEL=info

# Read the client address from X-Forwarded-For. Only turn this on together with
# TRUSTED_PROXY_CIDRS; every immediate/intermediate proxy hop that Parley may
# see must be listed. X-Real-IP and True-Client-IP are always ignored.
TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8

# Finite open-mode abuse boundaries. Every value must be a positive integer.
IDENTITY_IP_HOURLY_LIMIT=10
IDENTITY_GLOBAL_HOURLY_LIMIT=500
# Signed-link redemptions per address per hour. Its own bucket, so a team behind
# one NAT can reach a link's 25-redemption cap; keep it at or above 25.
LINK_REDEMPTION_IP_HOURLY_LIMIT=50
SPACE_LIMIT_PER_IDENTITY=50
SESSION_LIMIT_PER_SPACE=500
# Saved card decks one space may keep. A deck is a template a session copies
# from, so lowering this never touches a session already created.
DECK_LIMIT_PER_SPACE=20
STORY_LIMIT_PER_SESSION=500
LINK_LIMIT_PER_SESSION=20

# open | oidc
#
# "open" is the default: people type a name and take a seat, no accounts.
# "oidc" hands sign-in to your identity provider and turns the anonymous door
# off entirely. Any provider with a discovery document works — Keycloak,
# Authentik, Zitadel, Auth0, Okta, Entra, Google — so switching is config, not
# code. Register the redirect URI <BASE_URL>/auth/callback with the provider.
AUTH_MODE=open

# Required when AUTH_MODE=oidc. The issuer is the base address that serves
# /.well-known/openid-configuration, without that suffix.
# OIDC_ISSUER=https://keycloak.example.com/realms/yourteam
# OIDC_CLIENT_ID=parley
# Leave the secret unset for a public-client registration; PKCE carries the
# flow either way.
# OIDC_CLIENT_SECRET=
# Scopes beyond "openid", which is always requested.
# OIDC_SCOPES=profile email
# The id_token claim carrying the caller's groups. Its values are matched
# exactly and case-sensitively against the claim value an admin registered on
# each org; a value no org claims grants nothing and creates nothing. The claim
# may be a single string or an array of strings, and may be absent.
# OIDC_ORG_CLAIM=groups
# Bootstrap, for a fresh instance only. Without them nobody is an admin, so
# nobody can create the first org.
# The group value the built-in default org answers to:
# PARLEY_DEFAULT_ORG_CLAIM=parley-users
# The first admin, as issuer|subject — the pair from the id_token, because the
# account does not exist until they first sign in.
# PARLEY_BOOTSTRAP_ADMIN=https://keycloak.example.com/realms/yourteam|8f2c...

# --- Plugins -----------------------------------------------------------------
#
# The plugin foundations ship dormant: no plugin runs until a host is installed.
# Both variables are optional.
#
# The key plugin secrets are encrypted with — base64, exactly 32 bytes decoded.
# Generate one with: openssl rand -base64 32
# Leave it unset and plugin secrets are unavailable: a plugin that asks for them
# fails to install rather than storing credentials in the clear.
# PLUGIN_SECRET_KEY=
# How long a fully-delivered plugin event is kept before it is pruned.
# PLUGIN_EVENT_RETENTION=168h

# Directory plugin bundles are read from, as "<name>-<version>.wasm". A plugin
# that ships UI puts it beside the bundle as "<name>-<version>.ui.js"; the
# server inlines that file into the sandboxed frame it serves at
# /plugin-ui/<name>/<version>, because the frame's policy lets it fetch
# nothing. Leave PLUGIN_DIR unset and no plugin host runs at all, and the
# framed route is not registered: an instance that has not been given plugins
# does not gain a WebAssembly runtime — or an embeddable page — by upgrading.
# PLUGIN_DIR=
# The containment budget one plugin call gets. A plugin has no sockets, no
# filesystem and no SQL; these bound what it can do to the process it shares.
# See site/src/content/docs/security/plugin-sandbox.mdx.
# PLUGIN_CALL_TIMEOUT=2s
# PLUGIN_MEMORY_PAGES=256
# PLUGIN_MAX_CONCURRENT_CALLS=8
# PLUGIN_MAX_CALLS_PER_PLUGIN=2
# PLUGIN_MODULE_CACHE_SIZE=16

# Path to an optional file of KEY=value lines, merged UNDER this environment:
# anything already set here wins, the file only fills the gaps. A missing file
# or a line without an "=" stops the process.
# PARLEY_CONFIG_FILE=/etc/parley/parley.conf
