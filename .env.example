# Required. Postgres password used by both containers.
POSTGRES_PASSWORD=

# The address users reach the app at. Drives the WebSocket origin check and
# whether the session cookie is marked Secure. Change this if teammates connect
# over the network, e.g. http://192.168.1.10:8080 or https://parley.example.com
BASE_URL=http://localhost:8080

# debug | info | warn | error
LOG_LEVEL=info
